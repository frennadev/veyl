# Veyl on Solana: every variable read by the deploy scripts, the relayer and the site build.
# Copy to .env (gitignored) and fill in. Never put key material in this file: only PATHS to keypair files kept outside the repo,
# except on a host like Render, where the relayer's own hot-wallet key goes into the host's secret env (RELAYER_SECRET_KEY).

# ---- deploy / preflight (scripts/deploy.js, scripts/preflight.js)
DEPLOYER_KEYPAIR=~/keys/veyl-devnet-deployer.json   # path to the paying + upgrade-authority keypair (solana-keygen new -o ...)
RPC_URL=                                            # optional: overrides config/<network>.json "rpc" (use a paid RPC on mainnet)
PROGRAM_KEYPAIR_DIR=                                # optional: dir with veyl_pool/veyl_bin/veyl_entry-keypair.json (default target/deploy = dev IDs; mainnet needs fresh ones)
POSTMAN_PUBKEY=                                     # approved-set publisher pubkey (default: deployer on local/devnet; required + separate on mainnet)
RELAYER_PUBKEY=                                     # relayer hot-wallet pubkey (default: deployer on local/devnet; required + separate on mainnet)
PRIORITY_FEE_MICROLAMPORTS=                         # optional: compute-unit price for the program deploy transactions
SOLANA_BIN=                                         # optional: dir of the solana CLI if it is not on PATH

# ---- relayer service (relayer/relayer.js)
NETWORK=devnet                                      # which deploy.<network>.json to load (local | devnet | mainnet)
DEPLOY_FILE=                                        # optional: path to a deploy.<network>.json instead of the repo copy
DEPLOY_JSON=                                        # optional: the whole deploy.<network>.json as a string (hosts without the file)
RELAYER_SECRET_KEY=                                 # the relayer's OWN fee-only hot wallet: JSON byte array or base58 (host secret). Or:
RELAYER_KEY=                                        #   path to that keypair file
POSTMAN_SECRET_KEY=                                 # optional: run the approved-set publisher in the same process (JSON array / base58). Or:
POSTMAN_KEY=                                        #   path to that keypair file
PORT=8843                                           # HTTP port (/health, /info, /state, /pools, /fee, /submit)
MIN_FEE_BPS=5                                       # relayer fee in basis points of the amount (max is fixed on-chain)
ASP_INTERVAL_MS=30000                               # how often the publisher rebuilds and publishes the approved set
ADMIT_INTERVAL_MS=5000                               # how often the publisher admits pending deposits into the shielded pool (Phase 2)
ALLOWED_ORIGINS=                                    # CORS: comma-separated site origins (e.g. https://veyl.example); empty = any
LOW_BALANCE_SOL=0.05                                # /health reports lowBalance below this
FEE_COVER=1                                         # fee floor: the fee must pay back this multiple of the rent + fees each request costs the relayer
PRICES_JSON=                                        # optional USD prices for that floor, e.g. {"SOL":150,"USDC":1} (default: the deploy file's prices)
TRUST_PROXY=                                        # behind a proxy (Render: 1): rate-limit on the client address in X-Forwarded-For
FAUCET_SECRET_KEY=                                  # DEVNET/LOCAL ONLY: the deployer key (mock-mint authority) for POST /drip. Or:
FAUCET_KEY=                                         #   path to that keypair file. Never set on mainnet (the relayer ignores it there).
SEALED_CRANK=                                       # 0 turns off the relayer's sealed-batch crank (closes/fails batches); default on
CRANK_INTERVAL_MS=4000                              # how often that crank runs

# ---- site build (scripts/build-site.js)
RELAYER_URL=https://veyl-sol-relayer.onrender.com   # public URL of the relayer, baked into dist/site/veyl.config.js
SITE_RPC_URL=                                       # optional: RPC the browser uses (default: the deploy's RPC)
CHAIN_NAME=                                         # optional: label shown in the app (default from config)
EXPLORER=                                           # optional: explorer base URL (default from config)
BIRDEYE_API_KEY=                                    # optional keys for live market data, written into dist/site/veyl.keys.js (DEPLOY.md)
HELIUS_API_KEY=
JUPITER_API_KEY=
PYTH_API_KEY=

# ---- batch committee / sealed swaps (scripts/deploy.js, scripts/preflight.js)
COMMITTEE_TRANSCRIPT=                               # optional: DKG transcript to register (default committee/transcript.<network>.json)

# ---- local tooling
RPC_PORT=8933                                       # local validator RPC port (websocket +1, gossip +3000)
FUND=                                               # GO-LIVE local: a wallet to fund with mock tokens
CORE_ONLY=                                          # VEYL-DEVNET.command: 1 = only the 12 built-in pools (cheaper than all 83)
